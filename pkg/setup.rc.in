#include <winver.h>
#include "Brand.h"

IDI_ICON1 ICON "@RUBIDIUM_PKG_DIR@/logo.ico"

VS_VERSION_INFO VERSIONINFO
   FILEVERSION    @RUBIDIUM_VER_MAJOR@,@RUBIDIUM_VER_MINOR@,@RUBIDIUM_VER_PATCH@,0
   PRODUCTVERSION @RUBIDIUM_VER_MAJOR@,@RUBIDIUM_VER_MINOR@,@RUBIDIUM_VER_PATCH@,0
   FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
   FILEFLAGS      0
   FILEOS         VOS_NT_WINDOWS32
   FILETYPE       VFT_APP
   FILESUBTYPE    VFT2_UNKNOWN
BEGIN
   BLOCK "StringFileInfo"
   BEGIN
      BLOCK "040904B0"
      BEGIN
         VALUE "CompanyName",      PRODUCT_COMPANY
         VALUE "FileDescription",  PRODUCT_DESCRIPTION_SETUP
         VALUE "FileVersion",      "@RUBIDIUM_VER@"
         VALUE "InternalName",     PRODUCT_NAME_SETUP
         VALUE "LegalCopyright",   "Copyright 2026 Metaversal Corporation. All rights reserved."
         VALUE "OriginalFilename", PRODUCT_SETUP_EXE
         VALUE "ProductName",      PRODUCT_NAME
         VALUE "ProductVersion",   "@RUBIDIUM_VER@"
      END
   END
   BLOCK "VarFileInfo"
   BEGIN
      VALUE "Translation", 0x0409, 0x04B0
   END
END
