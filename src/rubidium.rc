#include <windows.h>
#include <commctrl.h>
#include "version.h"
#include "Brand.h"
#include "resource.h"

IDI_ICON1    ICON "../pkg/logo.ico"
IDI_TAB_ICON ICON "../pkg/logo.ico"

IDR_ACCEL ACCELERATORS
BEGIN
VK_F5,  IDM_RELOAD,        VIRTKEY
VK_F5,  IDM_RELOAD_RESET,  VIRTKEY, CONTROL
"R",    IDM_RELOAD,        VIRTKEY, CONTROL
"R",    IDM_RELOAD_RESET,  VIRTKEY, CONTROL, SHIFT
VK_F12, IDM_INSPECTOR_RML, VIRTKEY
END

VS_VERSION_INFO VERSIONINFO
   FILEVERSION    RUBIDIUM_VER_MAJOR,RUBIDIUM_VER_MINOR,RUBIDIUM_VER_PATCH,0
   PRODUCTVERSION RUBIDIUM_VER_MAJOR,RUBIDIUM_VER_MINOR,RUBIDIUM_VER_PATCH,0
   FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
   FILEFLAGS      0
   FILEOS         VOS_NT_WINDOWS32
   FILETYPE       VFT_APP
   FILESUBTYPE    VFT2_UNKNOWN
BEGIN
   BLOCK "StringFileInfo"
   BEGIN
      BLOCK "040904B0"
      BEGIN
         VALUE "CompanyName",      PRODUCT_COMPANY
         VALUE "FileDescription",  PRODUCT_DESCRIPTION
         VALUE "FileVersion",      RUBIDIUM_VERSION
         VALUE "InternalName",     PRODUCT_NAME
         VALUE "LegalCopyright",   "Copyright 2026 Metaversal Corporation. All rights reserved."
         VALUE "OriginalFilename", PRODUCT_EXE
         VALUE "ProductName",      PRODUCT_NAME
         VALUE "ProductVersion",   RUBIDIUM_VERSION
      END
   END
   BLOCK "VarFileInfo"
   BEGIN
      VALUE "Translation", 0x0409, 0x04B0
   END
END
